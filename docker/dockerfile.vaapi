FROM ffmpeg-base:latest AS vaapi

ARG FFMPEG_VERSION=9.0.2
ARG BUILD_VARIANT=full

COPY scripts/version-gates.sh scripts/variant.sh /tmp/

# V4L2 M2M (Pi HW decode) uses kernel UAPI headers from ffmpeg-base (linux-headers).

# libva — static build from sources.json (default hwaccel for Linux static ffmpeg).
COPY [ "src/libva-*", "./libva" ]
RUN . /tmp/version-gates.sh && export BUILD_VARIANT="${BUILD_VARIANT}" && \
  if ! needs_vaapi_build; then \
    echo "Skipping libva build"; \
  else \
    cd libva && \
    meson setup build \
      -Dbuildtype=release \
      -Ddefault_library=static \
      -Ddisable_drm=false \
      -Dwith_x11=no \
      -Dwith_glx=no \
      -Dwith_wayland=no \
      -Dwith_win32=no \
      -Dwith_legacy=[] \
      -Denable_docs=false && \
    ninja -j$(nproc) -vC build install; \
  fi

# libvpl (Intel Video Processing Library - oneAPI Video Processing Library)
COPY [ "src/libvpl-*", "./libvpl" ]
RUN . /tmp/version-gates.sh && export BUILD_VARIANT="${BUILD_VARIANT}" && \
  if ! needs_libvpl_build "$FFMPEG_VERSION"; then \
    echo "Skipping libvpl build (FFmpeg ${FFMPEG_VERSION} < 6.0)"; \
  else \
    cd libvpl && \
    cmake -B build \
      -G"Unix Makefiles" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_VERBOSE_MAKEFILE=ON \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DBUILD_SHARED_LIBS=OFF \
      -DBUILD_TESTS=OFF \
      -DENABLE_WARNING_AS_ERROR=OFF && \
    cmake --build build -j$(nproc) && \
    cmake --install build; \
  fi
