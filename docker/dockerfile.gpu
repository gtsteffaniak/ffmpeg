# syntax=docker/dockerfile:1.4
# Debian 13 (trixie) GPU FFmpeg for linux/amd64.
# Mostly-static codecs + dynamically linked GPU glue (libva, libvpl,
# libvulkan, OpenCL). NVIDIA NVENC/NVDEC/CUDA headers come from
# nv-codec-headers (ffnvcodec.pc); AMD AMF headers from the GPUOpen
# AMF SDK (AMF/core/Version.h) — neither ships with FFmpeg 9.
#
#   docker build -f docker/dockerfile.gpu -t gtstef/ffmpeg:<ver>-gpu .
#
# Version comes from sources.json (release.ffmpeg_version), parsed
# with jq inside the build — no --build-arg needed. Base is hardcoded
# to Debian 13 trixie (builder debian:trixie, runtime
# debian:trixie-slim): Mesa 25.0, libva 2.22, intel-media-va-driver
# 25.2, libvpl 2.14. Trixie is chosen for current
# Intel Arc / Arrow Lake / AMD support; forky (testing) is not used
# for release images.
#
# libvmaf, xeve, xevd, vvenc, davs2, uavs3d have no trixie -dev
# packages, so they are built from src/* tarballs. libplacebo is
# disabled: trixie ships 7.349.0 but FFmpeg 9 requires >= 7.351.0.

FROM debian:trixie AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"

# Builder packages (Debian 13 trixie).
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  yasm \
  nasm \
  cmake \
  meson \
  ninja-build \
  pkg-config \
  libtool \
  autoconf \
  automake \
  git \
  curl \
  jq \
  python3 \
  ca-certificates \
  linux-libc-dev \
  libva-dev \
  libdrm-dev \
  libvulkan-dev \
  spirv-headers \
  glslang-dev \
  glslang-tools \
  ocl-icd-opencl-dev \
  libvpl-dev \
  libvdpau-dev \
  libx264-dev \
  libx265-dev \
  libmp3lame-dev \
  libdav1d-dev \
  libaom-dev \
  libvpx-dev \
  libsvtav1enc-dev \
  librav1e-dev \
  libvorbis-dev \
  libopus-dev \
  libass-dev \
  libfreetype-dev \
  libfribidi-dev \
  libharfbuzz-dev \
  libfontconfig-dev \
  libsoxr-dev \
  libsnappy-dev \
  libmysofa-dev \
  libvidstab-dev \
  libwebp-dev \
  libopenjp2-7-dev \
  libzimg-dev \
  liblcms2-dev \
  libxml2-dev \
  libvo-amrwbenc-dev \
  libbluray-dev \
  libsrt-openssl-dev \
  librubberband-dev \
  libtwolame-dev \
  libjxl-dev \
  libgsm1-dev \
  libogg-dev \
  libpng-dev \
  libjpeg62-turbo-dev \
  zlib1g-dev \
  libssl-dev \
  libepoxy-dev \
  libgl-dev \
  xxd \
  && rm -rf /var/lib/apt/lists/*

# NVIDIA + AMD headers: FFmpeg 9 requires the external ffnvcodec
# pkg-config package (>= 12.1.14.0) and AMF headers
# (>= AMF 1.5.0.2.0.0). Install both header-only SDKs before configure.
RUN git clone --depth 1 --branch n13.1.15.0 https://github.com/FFmpeg/nv-codec-headers /tmp/nv-codec-headers \
  && make -C /tmp/nv-codec-headers install PREFIX=/usr/local \
  && git clone --depth 1 --branch v1.5.3 https://github.com/GPUOpen-LibrariesAndSDKs/AMF /tmp/AMF \
  && install -d /usr/local/include/AMF \
  && cp -r /tmp/AMF/amf/public/include/* /usr/local/include/AMF/ \
  && test -f /usr/local/include/AMF/core/Version.h \
  && test -f /usr/local/lib/pkgconfig/ffnvcodec.pc

# libvmaf is not packaged in Debian. Build it from the src/vmaf-*
# tarball when present, static into /usr/local. FFmpeg 9 requires
# libvmaf >= 2.0.0; sources.json ships 3.2.1.
COPY [ "src/vmaf-*", "./vmaf" ]
RUN if [ -f vmaf/libvmaf/meson.build ]; then \
  cd vmaf/libvmaf && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dbuilt_in_models=true \
    -Denable_tests=false \
    -Denable_docs=false \
    -Dlibdir=lib \
    && ninja -j"$(nproc)" -C build install \
    && sed -i 's/-lvmaf /-lvmaf -lstdc++ /' /usr/local/lib/pkgconfig/libvmaf.pc \
    && ldd /usr/local/lib/libvmaf.a >/dev/null 2>&1 || true; \
  fi

# xeve, xevd, vvenc, davs2, uavs3d have no trixie -dev packages.
# Build them from the src/* tarballs populated by fetch-sources.

COPY [ "src/xeve-*", "./xeve" ]
RUN cd xeve && \
  sed -i 's/mc_filter_bilin/xevem_mc_filter_bilin/' src_main/sse/xevem_mc_sse.c && \
  mkdir build && cd build && \
  cmake \
    -G"Unix Makefiles" \
    -DARM="FALSE" \
    -DCMAKE_BUILD_TYPE=Release \
    .. && \
  make -j$(nproc) install && \
  ln -s /usr/local/lib/xeve/libxeve.a /usr/local/lib/libxeve.a 2>/dev/null || true

COPY [ "src/xevd-*", "./xevd" ]
RUN cd xevd && \
  sed -i 's/mc_filter_bilin/xevdm_mc_filter_bilin/' src_main/sse/xevdm_mc_sse.c && \
  mkdir build && cd build && \
  cmake \
    -G"Unix Makefiles" \
    -DARM="FALSE" \
    -DCMAKE_BUILD_TYPE=Release \
    .. && \
  make -j$(nproc) install && \
  ln -s /usr/local/lib/xevd/libxevd.a /usr/local/lib/libxevd.a 2>/dev/null || true

COPY [ "src/vvenc-*", "./vvenc" ]
RUN cd vvenc && \
  sed -i 's/-Werror;//' source/Lib/vvenc/CMakeLists.txt && \
  cmake \
    -S . \
    -B build/release-static \
    -DVVENC_ENABLE_WERROR=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local && \
  cmake --build build/release-static -j && \
  cmake --build build/release-static --target install

COPY [ "src/davs2-*", "./davs2" ]
RUN cd davs2/build/linux && \
  ./configure \
    --disable-asm \
    --enable-pic \
    --enable-strip \
    --disable-cli && \
  make -j$(nproc) install

COPY [ "src/uavs3d-*", "./uavs3d" ]
RUN cd uavs3d && \
  sed -i '/armv7\.c/d' source/CMakeLists.txt 2>/dev/null || true; \
  mkdir -p build/linux && cd build/linux && \
  cmake \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    ../.. && \
  make -j$(nproc) install

COPY sources.json /tmp/sources.json
COPY scripts/version-gates.sh /tmp/version-gates.sh

COPY [ "src/ffmpeg*", "./ffmpeg" ]
RUN cd ffmpeg && \
  FFMPEG_VERSION="$(jq -r .release.ffmpeg_version /tmp/sources.json)" && \
  test -n "$FFMPEG_VERSION" && test "$FFMPEG_VERSION" != "null" && \
  . /tmp/version-gates.sh && \
  apply_svtav1_api_patch && \
  build_gpu_configure_flags ./configure "$FFMPEG_VERSION" "false" && \
  echo "GPU configure flags: BASE_FLAGS=$BASE_FLAGS FEATURES=$FEATURES" && \
  ./configure \
    --prefix=/usr/local \
    --pkg-config-flags="" \
    --extra-cflags="-O3" \
    --extra-cxxflags="-O3" \
    --disable-ffplay \
    --disable-doc \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --enable-openssl \
    $BASE_FLAGS \
    $FEATURES \
  && make -j"$(nproc)" install \
  && ffmpeg -version | head -1 \
  && ldd /usr/local/bin/ffmpeg

FROM debian:trixie-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
  NVIDIA_VISIBLE_DEVICES=all \
  NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics \
  PATH="/usr/local/bin:$PATH"

# Runtime libs: GPU userspace drivers + codec shared libs.
# GPU glue SONAMEs (libva.so.2, libvpl.so.2, libvulkan.so.1) are
# expected by scripts/check-gpu.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  tzdata \
  fonts-dejavu-core \
  fontconfig \
  libva2 \
  libva-drm2 \
  libdrm2 \
  libvpl2 \
  libvulkan1 \
  mesa-va-drivers \
  mesa-vulkan-drivers \
  intel-media-va-driver \
  libmfx-gen1.2 \
  ocl-icd-libopencl1 \
  libdav1d7 \
  libaom3 \
  libvpx9 \
  libsvtav1enc2 \
  librav1e0.7 \
  libx264-164 \
  libx265-215 \
  libmp3lame0 \
  libvorbisenc2 \
  libvorbis0a \
  libopus0 \
  libogg0 \
  libass9 \
  libfreetype6 \
  libfribidi0 \
  libharfbuzz0b \
  libfontconfig1 \
  libsoxr0 \
  libsnappy1v5 \
  libmysofa1 \
  libvidstab1.1 \
  libwebp7 \
  libopenjp2-7 \
  libzimg2 \
  liblcms2-2 \
  libxml2 \
  libvo-amrwbenc0 \
  libbluray2 \
  libsrt1.5-openssl \
  librubberband2 \
  libtwolame0 \
  libjxl0.11 \
  libgsm1 \
  libpng16-16t64 \
  libjpeg62-turbo \
  libepoxy0 \
  libgl1 \
  libstdc++6 \
  && rm -rf /var/lib/apt/lists/* \
  && ldconfig

COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=builder /usr/local/lib/ /usr/local/lib/
COPY --from=builder /usr/local/share/ffmpeg/ /usr/local/share/ffmpeg/

RUN ldconfig

RUN ffmpeg -version && ffprobe -version

ENTRYPOINT ["/usr/local/bin/ffmpeg"]
