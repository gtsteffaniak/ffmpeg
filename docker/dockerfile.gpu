# syntax=docker/dockerfile:1.4
# Track G — Debian GPU FFmpeg (x86_64 only).
#
# Mostly-static codecs + dynamically-linked GPU glue (libva, libvpl,
# libvulkan, OpenCL, NVIDIA headers from nv-codec-headers, AMD headers
# from the AMF SDK,
# published as gtstef/ffmpeg:<ver>-gpu. Additive only: the Alpine static
# track (Track S) in docker/dockerfile.* is untouched.
#
#   docker build -f docker/dockerfile.gpu --build-arg FFMPEG_VERSION=9.0.2 -t gtstef/ffmpeg:9.0.2-gpu .
#
# Base is Debian 13 Trixie (ARG DEBIAN_VERSION, default trixie):
# Mesa 25.0, libva 2.22, intel-media-va-driver 25.2, libvpl 2.14,
# Vulkan headers 1.4.309 — fresh enough for current Intel Arc /
# Arrow Lake / AMD iGPUs. Override with e.g.
# --build-arg DEBIAN_VERSION=bookworm to test the old base as a
# fallback if Trixie blocks the build (package lists below are
# Trixie names; the bookworm names differ for a few SONAME packages,
# see README "Trixie package notes").
# NVENC/NVDEC/AMF headers are installed below from nv-codec-headers
# (FFmpeg/nv-codec-headers, provides ffnvcodec.pc) and the AMD AMF SDK
# (GPUOpen-LibrariesAndSDKs/AMF, AMF/core/Version.h). FFmpeg 9 does not
# ship them; its configure requires the external ffnvcodec pkg-config
# package (>= 12.1.14.0) and AMF headers (>= AMF 1.5.0.2.0.0).

ARG DEBIAN_VERSION=trixie

FROM debian:${DEBIAN_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"

# Builder -dev packages, re-validated against Debian Trixie
# (packages.debian.org / trixie main Packages index, 2026-11-13).
# Changes vs the old Bookworm list:
#   libva-drm-dev  DROPPED — never existed in Bookworm or Trixie;
#                  trixie libva-dev ships va/va_drm.h + libva-drm.pc
#                  (verified in libva-dev_2.22.0-3_amd64.deb).
#   libsvtav1-dev -> libsvtav1enc-dev (SVT-AV1 2.3 in Trixie; the
#                  Debian package was renamed and now Replaces:
#                  libsvtav1-dev. Ships EbSvtAv1Enc.h + SvtAv1Enc.pc,
#                  matching FFmpeg 9's require_pkg_config "SvtAv1Enc >= 0.9.0").
# All other names exist unchanged in Trixie (versions bumped, e.g.
# dav1d 1.5.1, aom 3.12.1, x265 4.1, rav1e 0.7.1, glslang 15.1,
# Vulkan headers 1.4.309).
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  yasm \
  nasm \
  cmake \
  meson \
  ninja-build \
  pkg-config \
  libtool \
  autoconf \
  automake \
  git \
  curl \
  jq \
  python3 \
  ca-certificates \
  linux-libc-dev \
  libva-dev \
  libdrm-dev \
  libvulkan-dev \
  spirv-headers \
  glslang-dev \
  glslang-tools \
  ocl-icd-opencl-dev \
  libvpl-dev \
  libvdpau-dev \
  libx264-dev \
  libx265-dev \
  libmp3lame-dev \
  libdav1d-dev \
  libaom-dev \
  libvpx-dev \
  libsvtav1enc-dev \
  librav1e-dev \
  libvorbis-dev \
  libopus-dev \
  libass-dev \
  libfreetype-dev \
  libfribidi-dev \
  libharfbuzz-dev \
  libfontconfig-dev \
  libsoxr-dev \
  libsnappy-dev \
  libmysofa-dev \
  libvidstab-dev \
  libwebp-dev \
  libopenjp2-7-dev \
  libzimg-dev \
  liblcms2-dev \
  libxml2-dev \
  libvo-amrwbenc-dev \
  libbluray-dev \
  libsrt-openssl-dev \
  librubberband-dev \
  libtwolame-dev \
  libjxl-dev \
  libgsm1-dev \
  libogg-dev \
  libpng-dev \
  libjpeg62-turbo-dev \
  zlib1g-dev \
  libssl-dev \
  libepoxy-dev \
  libgl-dev \
  && rm -rf /var/lib/apt/lists/*

# --- NVIDIA (NVENC/NVDEC/CUDA) + AMD AMF headers ----------------------
# FFmpeg 9.0.2 configure checks:
#   check_pkg_config ffnvcodec "ffnvcodec >= 12.1.14.0" ... plus
#   check_type "ffnvcodec/nvEncodeAPI.h" / dynlink headers, and
#   check_cpp_condition amf "AMF/core/Version.h" version >= 0x1000500020000
# Neither ships with the FFmpeg tarball. Install both header-only SDKs
# before configure:
#   nv-codec-headers n13.1.15.0 — headers + ffnvcodec.pc (make install)
#   AMF v1.5.3 — AMF/core/Version.h (1.5.3.0 >= 1.5.0.2.0.0) copied to
#                /usr/local/include/AMF/{core,components,...}
# Runtime CUDA/NV driver libs stay on the host (NVIDIA container
# toolkit); these header-only installs add no runtime dependency.
RUN git clone --depth 1 --branch n13.1.15.0 https://github.com/FFmpeg/nv-codec-headers /tmp/nv-codec-headers \
  && make -C /tmp/nv-codec-headers install PREFIX=/usr/local \
  && git clone --depth 1 --branch v1.5.3 https://github.com/GPUOpen-LibrariesAndSDKs/AMF /tmp/AMF \
  && install -d /usr/local/include/AMF \
  && cp -r /tmp/AMF/amf/public/include/* /usr/local/include/AMF/ \
  && test -f /usr/local/include/AMF/core/Version.h \
  && test -f /usr/local/lib/pkgconfig/ffnvcodec.pc

# libvmaf: still not packaged in Trixie (verified: packages.debian.org
# search "vmaf" in trixie returns no results; Package index has no
# libvmaf*). Build it from the existing src/* tarball when present
# (same source as the static track's docker/dockerfile.processing),
# static into /usr/local. FFmpeg 9 requires libvmaf >= 2.0.0; the
# sources.json vmaf is 3.2.1. If src/vmaf-* is absent,
# build_gpu_configure_flags() still tries --enable-libvmaf via
# append_if_supported() and skips cleanly when the .pc file is missing.
#
# libplacebo: intentionally NOT enabled. Trixie ships libplacebo-dev
# 7.349.0, but FFmpeg 9.0's configure requires
# 'libplacebo >= 7.351.0' (require_pkg_config ... pl_vulkan_create),
# so Trixie's version fails the check — same skip as Bookworm, for a
# different (closer) reason. scale_vulkan does not need it:
# scale_vulkan_filter_deps="vulkan spirv_compiler swscale" in FFmpeg 9.
# Revisit when Debian ships >= 7.351.
COPY [ "src/vmaf-*", "./vmaf" ]
RUN if [ -f vmaf/libvmaf/meson.build ]; then \
  cd vmaf/libvmaf && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static \
    -Dbuilt_in_models=true \
    -Denable_tests=false \
    -Denable_docs=false \
    -Dlibdir=lib \
    && ninja -j"$(nproc)" -C build install \
    && sed -i 's/-lvmaf /-lvmaf -lstdc++ /' /usr/local/lib/pkgconfig/libvmaf.pc \
    && ldd /usr/local/lib/libvmaf.a >/dev/null 2>&1 || true; \
  fi

# --- Modern-codec source builds (full parity with Track S) -------------
# Trixie ships NO libxeve/libxevd/libvvenc/libdavs2/libuavs3d -dev
# packages (verified: trixie main index has no such Package: entries),
# but build_gpu_configure_flags() emits --enable-libxeve/-libxevd/
# -libvvenc/-libdavs2/-libuavs3d, and FFmpeg 9 configure then requires
# their pkg-config metadata — without these builds configure fails.
# Build them from the same fetch-sources tarballs Track S uses
# (docker/dockerfile.modern-codecs + docker/dockerfile.codecs),
# static into /usr/local like the other codecs. fetch-sources has
# already populated src/ (build-gpu.sh / gpu.yml run it first).

COPY [ "src/xeve-*", "./xeve" ]
RUN cd xeve && \
  sed -i 's/mc_filter_bilin/xevem_mc_filter_bilin/' src_main/sse/xevem_mc_sse.c && \
  mkdir build && cd build && \
  cmake \
    -G"Unix Makefiles" \
    -DARM="FALSE" \
    -DCMAKE_BUILD_TYPE=Release \
    .. && \
  make -j$(nproc) install && \
  ln -s /usr/local/lib/xeve/libxeve.a /usr/local/lib/libxeve.a 2>/dev/null || true

COPY [ "src/xevd-*", "./xevd" ]
RUN cd xevd && \
  sed -i 's/mc_filter_bilin/xevdm_mc_filter_bilin/' src_main/sse/xevdm_mc_sse.c && \
  mkdir build && cd build && \
  cmake \
    -G"Unix Makefiles" \
    -DARM="FALSE" \
    -DCMAKE_BUILD_TYPE=Release \
    .. && \
  make -j$(nproc) install && \
  ln -s /usr/local/lib/xevd/libxevd.a /usr/local/lib/libxevd.a 2>/dev/null || true

COPY [ "src/vvenc-*", "./vvenc" ]
RUN cd vvenc && \
  sed -i 's/-Werror;//' source/Lib/vvenc/CMakeLists.txt && \
  cmake \
    -S . \
    -B build/release-static \
    -DVVENC_ENABLE_WERROR=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local && \
  cmake --build build/release-static -j && \
  cmake --build build/release-static --target install

COPY [ "src/davs2-*", "./davs2" ]
RUN cd davs2/build/linux && \
  ./configure \
    --disable-asm \
    --enable-pic \
    --enable-strip \
    --disable-cli && \
  make -j$(nproc) install

COPY [ "src/uavs3d-*", "./uavs3d" ]
RUN cd uavs3d && \
  sed -i '/armv7\.c/d' source/CMakeLists.txt 2>/dev/null || true; \
  mkdir -p build/linux && cd build/linux && \
  cmake \
    -G"Unix Makefiles" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    ../.. && \
  make -j$(nproc) install

ARG FFMPEG_VERSION=9.0.2

COPY scripts/version-gates.sh /tmp/version-gates.sh

COPY [ "src/ffmpeg*", "./ffmpeg" ]
RUN cd ffmpeg && \
  . /tmp/version-gates.sh && \
  apply_svtav1_api_patch && \
  build_gpu_configure_flags ./configure "$FFMPEG_VERSION" "false" && \
  echo "GPU configure flags: BASE_FLAGS=$BASE_FLAGS FEATURES=$FEATURES" && \
  ./configure \
    --prefix=/usr/local \
    --pkg-config-flags="" \
    --extra-cflags="-O3" \
    --extra-cxxflags="-O3" \
    --disable-ffplay \
    --disable-doc \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --enable-openssl \
    $BASE_FLAGS \
    $FEATURES \
  && make -j"$(nproc)" install \
  && ffmpeg -version | head -1 \
  && ldd /usr/local/bin/ffmpeg

FROM debian:${DEBIAN_VERSION}-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
  NVIDIA_VISIBLE_DEVICES=all \
  NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics \
  PATH="/usr/local/bin:$PATH"

# Runtime libs: GPU userspace drivers + codec shared libs.
# Trixie names, re-validated against the trixie main Packages index.
# Renames vs Bookworm (SONAME bumps / Trixie t64 transition):
#   libmfx1          REMOVED in Trixie -> libmfx-gen1.2 (Intel VPL GPU
#                    Runtime, the oneVPL implementation backend for
#                    Intel iGPUs; FFmpeg's --enable-libvpl links libvpl,
#                    not legacy libmfx, so no FFmpeg binary needs it
#                    directly, but QSV on Intel needs the impl lib)
#   libvpx7        -> libvpx9        (libvpx 1.15)
#   libsvtav1enc1  -> libsvtav1enc2  (SVT-AV1 2.3; enc/dec merged,
#   libsvtav1dec1     dropped — that name never existed in Bookworm
#                    either; 2.x ships a single libsvtav1enc2)
#   librav1e0      -> librav1e0.7    (rav1e 0.7.1)
#   libx265-199    -> libx265-215    (x265 4.1)
#   libjxl0.7      -> libjxl0.11     (JPEG XL 0.11.2)
#   libpng16-16    -> libpng16-16t64 (Trixie time64 transition)
#   libdav1d7        unchanged — and now actually correct: Bookworm's
#                    runtime was libdav1d6, so the old list's
#                    libdav1d7 would have failed on Bookworm too.
# All other names exist unchanged in Trixie (libva2, libvpl2,
# libvulkan1, mesa-va-drivers 25.0, intel-media-va-driver 25.2,
# libharfbuzz0b, libopenjp2-7 (.7 did NOT bump), libass9, ...).
# ldd in builder prints NEEDED entries; adjust this list from that
# output when recording size. SONAMEs for the GPU glue
# (libva.so.2, libvpl.so.2, libvulkan.so.1) are unchanged, so
# scripts/check-gpu.sh expectations hold as-is.
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  tzdata \
  fonts-dejavu-core \
  fontconfig \
  libva2 \
  libva-drm2 \
  libdrm2 \
  libvpl2 \
  libvulkan1 \
  mesa-va-drivers \
  mesa-vulkan-drivers \
  intel-media-va-driver \
  libmfx-gen1.2 \
  ocl-icd-libopencl1 \
  libdav1d7 \
  libaom3 \
  libvpx9 \
  libsvtav1enc2 \
  librav1e0.7 \
  libx264-164 \
  libx265-215 \
  libmp3lame0 \
  libvorbisenc2 \
  libvorbis0a \
  libopus0 \
  libogg0 \
  libass9 \
  libfreetype6 \
  libfribidi0 \
  libharfbuzz0b \
  libfontconfig1 \
  libsoxr0 \
  libsnappy1v5 \
  libmysofa1 \
  libvidstab1.1 \
  libwebp7 \
  libopenjp2-7 \
  libzimg2 \
  liblcms2-2 \
  libxml2 \
  libvo-amrwbenc0 \
  libbluray2 \
  libsrt1.5-openssl \
  librubberband2 \
  libtwolame0 \
  libjxl0.11 \
  libgsm1 \
  libpng16-16t64 \
  libjpeg62-turbo \
  libepoxy0 \
  libgl1 \
  libstdc++6 \
  && rm -rf /var/lib/apt/lists/* \
  && ldconfig

COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=builder /usr/local/lib/ /usr/local/lib/
COPY --from=builder /usr/local/share/ffmpeg/ /usr/local/share/ffmpeg/

RUN ffmpeg -version && ffprobe -version

ENTRYPOINT ["/usr/local/bin/ffmpeg"]
