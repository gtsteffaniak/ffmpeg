ARG ALPINE_VERSION=alpine:3.22
FROM ffmpeg-base:latest AS builder

ARG FFMPEG_VERSION=9.0.1
ARG DECODE_ONLY="false"

# Copy built libraries from all component stages
# Copy both /usr and /usr/local since some deps are from apk (in /usr) and others are built (in /usr/local)
COPY --from=ffmpeg-graphics:latest /usr/ /usr/
COPY --from=ffmpeg-av1:latest /usr/ /usr/
COPY --from=ffmpeg-x264-x265:latest /usr/ /usr/
COPY --from=ffmpeg-modern-codecs:latest /usr/ /usr/
COPY --from=ffmpeg-vpx-avs:latest /usr/ /usr/
COPY --from=ffmpeg-image-formats:latest /usr/ /usr/
COPY --from=ffmpeg-audio:latest /usr/ /usr/
COPY --from=ffmpeg-vaapi:latest /usr/ /usr/
COPY --from=ffmpeg-processing:latest /usr/ /usr/

COPY scripts/version-gates.sh scripts/verify-native-webp.sh /tmp/

# Build FFmpeg
COPY [ "src/ffmpeg*", "./ffmpeg" ]
RUN cd ffmpeg && \
  . /tmp/version-gates.sh && \
  apply_svtav1_api_patch && \
  build_ffmpeg_configure_flags ./configure "$FFMPEG_VERSION" "$DECODE_ONLY" && \
  PKG_CONFIG_PATH="/usr/lib/pkgconfig/:${PKG_CONFIG_PATH}" && \
  ./configure \
    --pkg-config-flags="--static" \
    --extra-cflags="$CFLAGS" \
    --extra-cxxflags="$CXXFLAGS" \
    --extra-ldexeflags="-fPIE -static-pie" \
    --extra-libs="-lm -fopenmp -lstdc++" \
    --enable-small \
    --enable-openssl \
    --disable-shared \
    --disable-ffplay \
    --enable-static \
    --enable-gpl \
    --enable-version3 \
    $BASE_FLAGS \
    $FEATURES \
  || (cat ffbuild/config.log ; false) && \
  install_ffmpeg_progs && \
  bundle_ffmpeg_doc /doc-bundle

RUN FFMPEG_VERSION="$FFMPEG_VERSION" DECODE_ONLY="$DECODE_ONLY" sh /tmp/verify-native-webp.sh

# Validate binaries (security checks: no dependencies, relro, pie, stack nx)
COPY checkelf.sh /
RUN \
  /checkelf.sh /usr/local/bin/ffmpeg && \
  /checkelf.sh /usr/local/bin/ffprobe

# Install fonts for subtitle rendering
RUN apk add $APK_OPTS font-terminus font-inconsolata font-dejavu font-awesome

# Testing stage - run sanity tests before creating final image
FROM scratch AS testing
COPY --from=builder /usr/local/bin/ffmpeg /
COPY --from=builder /usr/local/bin/ffprobe /
COPY --from=builder /doc-bundle/ /doc/
COPY --from=builder /etc/ssl/cert.pem /etc/ssl/cert.pem
COPY --from=builder /etc/fonts/ /etc/fonts/
COPY --from=builder /usr/share/fonts/ /usr/share/fonts/
COPY --from=builder /usr/share/consolefonts/ /usr/share/consolefonts/
COPY --from=builder /var/cache/fontconfig/ /var/cache/fontconfig/

# Sanity tests
RUN ["/ffmpeg", "-version"]
RUN ["/ffprobe", "-version"]
RUN ["/ffmpeg", "-hide_banner", "-buildconf"]
# Test DNS resolution
RUN ["/ffprobe", "-i", "https://github.com/favicon.ico"]
# Test TLS/HTTPS with certificate validation
RUN ["/ffprobe", "-tls_verify", "1", "-ca_file", "/etc/ssl/cert.pem", "-i", "https://github.com/favicon.ico"]
# Test SVG support
RUN ["/ffprobe", "-i", "https://github.githubassets.com/favicons/favicon.svg"]

# Final minimal image
FROM scratch
COPY --from=builder /usr/local/bin/ffmpeg /
COPY --from=builder /usr/local/bin/ffprobe /
COPY --from=builder /doc-bundle/ /doc/
COPY --from=builder /etc/ssl/cert.pem /etc/ssl/cert.pem
COPY --from=builder /etc/fonts/ /etc/fonts/
COPY --from=builder /usr/share/fonts/ /usr/share/fonts/
COPY --from=builder /usr/share/consolefonts/ /usr/share/consolefonts/
COPY --from=builder /var/cache/fontconfig/ /var/cache/fontconfig/

ENTRYPOINT ["/ffmpeg"]
