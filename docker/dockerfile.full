# Full-feature glibc FFmpeg (dynamic VA/NVENC/Vulkan/OpenCL; libvpl dispatcher static).
#
# Debian 11 (bullseye) is intentional for builder + runtime: glibc 2.31 sets the floor for
# extracted standalone linux/amd64|arm64 binaries (Ubuntu 20.04+, Debian 11+, RHEL 9+, etc.).
# In Docker, the host distro only needs a compatible kernel and device nodes; NVIDIA Container
# Toolkit injects host driver libs. Trade-off: older in-image Mesa/Intel VA stacks (very new GPUs
# may need newer drivers). WSL d3d12 VAAPI uses a bookworm Mesa driver file only — see
# scripts/install-mesa-bookworm-gpu.sh. Windows (mingw) and Alpine static scratch builds are separate.
ARG DEBIAN_VERSION=bullseye
FROM ffmpeg-debian-base:latest AS builder

ARG FFMPEG_VERSION=9.0.2
ARG TARGETARCH

COPY scripts/version-gates.sh scripts/variant.sh scripts/debian-full-build.sh \
  scripts/debian-vulkan-build-deps.sh scripts/checkldd.sh /tmp/
RUN chmod +x /tmp/debian-full-build.sh /tmp/debian-vulkan-build-deps.sh && cp /tmp/checkldd.sh /checkldd.sh

COPY [ "src/x264*", "./x264" ]
COPY [ "src/x265*", "./x265" ]
COPY [ "src/lame*", "./lame" ]
COPY [ "src/SVT-AV1*", "./SVT-AV1" ]
COPY [ "src/zimg*", "./zimg" ]
COPY [ "src/libvpl*", "./libvpl" ]
COPY [ "src/ffmpeg*", "./ffmpeg" ]

# nv-codec-headers (git shallow in sources.json or vendored)
RUN FFMPEG_VERSION="$FFMPEG_VERSION" TARGETARCH="$TARGETARCH" /tmp/debian-full-build.sh

FROM debian:${DEBIAN_VERSION}-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  fontconfig \
  fonts-dejavu-core \
  libgnutls30 \
  libass9 \
  libdav1d4 \
  libvpx6 \
  libmp3lame0 \
  libopus0 \
  libvorbis0a \
  libvorbisenc2 \
  libsoxr0 \
  libsnappy1v5 \
  liblcms2-2 \
  libopenjp2-7 \
  libaom0 \
  libmysofa1 \
  libvidstab1.1 \
  libvo-amrwbenc0 \
  libwebp6 \
  libwebpmux3 \
  libxml2 \
  libfreetype6 \
  libfribidi0 \
  libharfbuzz0b \
  libfontconfig1 \
  libnuma1 \
  libgomp1 \
  libva2 \
  libva-drm2 \
  libdrm2 \
  libvulkan1 \
  mesa-va-drivers \
  mesa-vulkan-drivers \
  ocl-icd-libopencl1 \
  && rm -rf /var/lib/apt/lists/* \
  && (dpkg --print-architecture | grep -q amd64 && apt-get update && apt-get install -y --no-install-recommends intel-media-va-driver libmfx1 && rm -rf /var/lib/apt/lists/* || true)

COPY scripts/install-mesa-bookworm-gpu.sh scripts/check-full-wsl-va.sh /tmp/
RUN chmod +x /tmp/install-mesa-bookworm-gpu.sh /tmp/check-full-wsl-va.sh && /tmp/install-mesa-bookworm-gpu.sh
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then /tmp/check-full-wsl-va.sh /; fi

COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=builder /doc-bundle/ /usr/share/doc/ffmpeg/

COPY scripts/smoke-test.sh scripts/checkldd.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/smoke-test.sh /usr/local/bin/checkldd.sh

# In-image smoke (no GPU in build environment)
RUN ffmpeg -version && ffprobe -version
RUN ffmpeg -version 2>&1 | grep -qi configuration && \
  ! ffmpeg -version 2>&1 | grep -q -- '--enable-nonfree'
RUN ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_nvenc
RUN ffmpeg -hide_banner -decoders 2>/dev/null | grep -q h264_cuvid
RUN ffmpeg -hide_banner -hwaccels 2>/dev/null | grep -qi vulkan
RUN ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_vulkan
RUN ffmpeg -hide_banner -encoders 2>/dev/null | grep -q hevc_vulkan
RUN ffmpeg -hide_banner -filters 2>/dev/null | grep -q scale_vulkan
RUN ffmpeg -hide_banner -f lavfi -i testsrc=duration=1:size=320x240:rate=1 \
  -c:v libx264 -preset ultrafast -frames:v 2 -an -f null -
RUN /usr/local/bin/checkldd.sh /usr/local/bin/ffmpeg

# NVIDIA Container Toolkit defaults to compute,utility (no libnvidia-encode/libnvcuvid).
# See https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/docker-specialized.html
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics

ENTRYPOINT ["/usr/local/bin/ffmpeg"]
