FROM ffmpeg-base:latest AS av1

ARG FFMPEG_VERSION=9.0.2
ARG BUILD_VARIANT=full
ARG DECODE_ONLY="false"

COPY scripts/version-gates.sh scripts/variant.sh /tmp/

# aom (AV1 reference encoder/decoder via libaom)
RUN . /tmp/version-gates.sh && export BUILD_VARIANT="${BUILD_VARIANT}" && \
  if needs_libaom "$FFMPEG_VERSION" "$DECODE_ONLY"; then \
    apk add $APK_OPTS aom-dev aom-static; \
  else \
    echo "Skipping libaom (DECODE_ONLY=${DECODE_ONLY})"; \
  fi

# dav1d (fast AV1 decoder)
COPY [ "src/dav1d-*", "./dav1d" ]
RUN cd dav1d && \
  meson setup build \
    -Dbuildtype=release \
    -Ddefault_library=static && \
  ninja -j$(nproc) -vC build install

# rav1e (Rust AV1 encoder)
RUN . /tmp/version-gates.sh && export BUILD_VARIANT="${BUILD_VARIANT}" && \
  if needs_rav1e_build; then \
    apk add $APK_OPTS rav1e-static rav1e-dev; \
  else \
    echo "Skipping rav1e build (BUILD_VARIANT=${BUILD_VARIANT})"; \
  fi

# SVT-AV1 (production AV1 encoder)
COPY [ "src/SVT-AV1-*", "./SVT-AV1" ]
RUN . /tmp/version-gates.sh && export BUILD_VARIANT="${BUILD_VARIANT}" && \
  if [ "$(uname -m)" = "armv7l" ] || ! needs_svtav1_build; then \
    echo "Skipping SVT-AV1 build"; \
  else \
    cd SVT-AV1 && \
    cd Build && \
    cmake \
      -G"Unix Makefiles" \
      -DCMAKE_VERBOSE_MAKEFILE=ON \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DBUILD_SHARED_LIBS=OFF \
      -DENABLE_AVX512=ON \
      -DCMAKE_BUILD_TYPE=Release \
      .. && \
    make -j$(nproc) install; \
  fi
