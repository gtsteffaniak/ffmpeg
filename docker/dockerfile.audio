FROM ffmpeg-base:latest AS audio

ARG FFMPEG_VERSION=9.0.1
ARG DECODE_ONLY="false"

COPY scripts/version-gates.sh /tmp/version-gates.sh

# libogg + libvorbis (encode / libvorbis decoder wrapper; native Vorbis decode when omitted)
RUN . /tmp/version-gates.sh && \
  if needs_libvorbis "$FFMPEG_VERSION" "$DECODE_ONLY"; then \
    apk add $APK_OPTS libogg-dev libogg-static libvorbis-dev libvorbis-static; \
  else \
    echo "Skipping libogg/libvorbis (DECODE_ONLY=${DECODE_ONLY})"; \
  fi

# opus (Modern high-quality audio codec)
RUN apk add $APK_OPTS opus-dev

# lame (MP3 encoder)
COPY [ "src/lame-*", "./lame" ]
RUN if [ "$DECODE_ONLY" = "true" ]; then \
    echo "Skipping lame build"; \
  else \
    cd lame && \
    ./configure \
      --disable-shared \
      --enable-static \
      --enable-nasm \
      --disable-gtktest \
      --disable-cpml \
      --disable-frontend && \
    make -j$(nproc) install; \
  fi

# rubberband (audio pitch shifting and time stretching)
COPY [ "src/rubberband-*", "./rubberband" ]
RUN if [ "$DECODE_ONLY" = "true" ]; then \
    echo "Skipping rubberband build"; \
  else \
    cd rubberband && \
    meson setup build \
      -Ddefault_library=static \
      -Dfft=fftw \
      -Dresampler=libsamplerate && \
    ninja -j$(nproc) -vC build install && \
    echo "Requires.private: fftw3 samplerate" >> /usr/local/lib/pkgconfig/rubberband.pc; \
  fi

# vo-amrwbenc (AMR-WB encoder for mobile audio)
RUN if [ "$DECODE_ONLY" = "true" ]; then \
    echo "Skipping vo-amrwbenc"; \
  else \
    apk add $APK_OPTS vo-amrwbenc-dev vo-amrwbenc-static; \
  fi
