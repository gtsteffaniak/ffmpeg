{
  "release": {
    "ffmpeg_version": "9.0.1",
    "mark_github_latest": false
  },
  "build": {
    "alpine_image": "alpine:3.22",
    "apk_repository": "https://dl-cdn.alpinelinux.org/alpine/edge/testing/"
  },
  "sources": [
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "enabled": true,
      "version": "9.0.1",
      "fetch": {
        "method": "archive",
        "url": "https://ffmpeg.org/releases/ffmpeg-{version}.tar.bz2",
        "dir": "ffmpeg-{version}"
      },
      "release": {
        "gate": "always"
      },
      "bump": {
        "repo": "https://github.com/FFmpeg/FFmpeg.git",
        "tag_filter": "*"
      }
    },
    {
      "id": "dav1d",
      "name": "dav1d",
      "enabled": true,
      "version": "1.5.1",
      "fetch": {
        "method": "git_tag",
        "url": "https://github.com/videolan/dav1d.git",
        "dir": "dav1d-{version}"
      },
      "release": {
        "gate": "always"
      },
      "bump": {
        "repo": "https://code.videolan.org/videolan/dav1d.git",
        "tag_filter": "*"
      }
    },
    {
      "id": "aom",
      "name": "libaom",
      "enabled": true,
      "version": "3.12.1",
      "commit": "10aece4157eb79315da205f39e19bf6ab3ee30d0",
      "fetch": {
        "method": "custom",
        "url": "https://aomedia.googlesource.com/aom",
        "dir": "aom",
        "post": "aom_verify"
      },
      "release": {
        "gate": "needs_libaom"
      },
      "bump": {
        "repo": "git:https://aomedia.googlesource.com/aom",
        "tag_filter": "*"
      }
    },
    {
      "id": "svtav1",
      "name": "SVT-AV1",
      "enabled": true,
      "version": "3.0.2",
      "fetch": {
        "method": "archive",
        "url": "https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v{version}/SVT-AV1-v{version}.tar.bz2",
        "dir": "SVT-AV1-{version}"
      },
      "release": {
        "gate": "decode_skip"
      },
      "bump": {
        "repo": "https://gitlab.com/AOMediaCodec/SVT-AV1.git",
        "tag_filter": "*"
      }
    },
    {
      "id": "rav1e",
      "name": "rav1e",
      "enabled": true,
      "fetch": {
        "method": "alpine",
        "package": "rav1e-dev"
      },
      "release": {
        "gate": "decode_skip"
      }
    },
    {
      "id": "x264",
      "name": "x264",
      "enabled": true,
      "commit": "b35605ace3ddf7c1a5d67a2eb553f034aef41d55",
      "fetch": {
        "method": "git_commit",
        "url": "https://code.videolan.org/videolan/x264.git",
        "dir": "x264"
      },
      "release": {
        "gate": "decode_skip"
      },
      "bump": {
        "method": "commit",
        "repo": "gitrefs:https://code.videolan.org/videolan/x264.git",
        "branch": "stable",
        "tag_filter": "re:#^refs/heads/stable$#|@commit"
      }
    },
    {
      "id": "x265",
      "name": "x265",
      "enabled": true,
      "version": "4.0",
      "fetch": {
        "method": "git_tag",
        "url": "https://bitbucket.org/multicoreware/x265_git.git",
        "dir": "x265-{version}"
